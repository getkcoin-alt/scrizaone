# Optional public configuration; no credentials belong in this file.
NEXT_PUBLIC_SITE_URL=https://www.scrizaone.com
# Leave blank until the free property exists and collection/consent is reviewed.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional public Google appointment-schedule URL; no tokens or private calendar IDs.
NEXT_PUBLIC_BOOKING_URL=
# Public verification values supplied by the actual property owner.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Server-only Riza credentials. Configure in Vercel; never expose with NEXT_PUBLIC_.
OPEN_ROUTER=
RESEND_MAIL=
# Optional separate random signing secret; otherwise derived server-side from the API key.
RIZA_SESSION_SECRET=
